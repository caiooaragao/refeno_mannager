# Docker Compose (copie para .env na raiz do projeto)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=refeno_manager
MYSQL_USER=refeno
MYSQL_PASSWORD=refeno

# API
API_PORT=3333
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000
SEED_ADMIN_LOGIN=dantenovaes
SEED_ADMIN_PASSWORD=danterefeno

# Web (URL pública da API — embutida no build do container Docker)
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_ADMIN_USER=dantenovaes
NEXT_PUBLIC_ADMIN_PASSWORD=danterefeno

# Desenvolvimento local (apps/api/.env — host aponta em localhost, não no container mysql)
DATABASE_URL=mysql://refeno:refeno@localhost:3306/refeno_manager
